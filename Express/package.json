{
  "name": "express",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:vanilla": "tsx watch src/vanilla-server.ts",
    "dev:nodemon": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.1",
    "nodemon": "^3.1.7",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
