# Copy this file to .env and adjust as needed.
# Base URL of the students API (json-server). Must be prefixed with VITE_ to be
# exposed to the app. Not secret — it ships in the built bundle.
VITE_API_BASE_URL=http://0.0.0.0:3000

# OAuth Client ID from Google Cloud Console. Not secret (it's meant to ship
# in the frontend bundle), but the app won't be able to show the Google
# login button without it.
VITE_GOOGLE_CLIENT_ID=<VITE_GOOGLE_CLIENT_ID>
